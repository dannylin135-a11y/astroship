---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="聯絡我們">
  <Container>
    <Sectionhead>
      <Fragment slot="title">聯絡我們</Fragment>
      <Fragment slot="desc">我們隨時為您服務。</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">武德玄德宮-財神爺</h2>
        <p class="text-lg leading-relaxed text-slate-500 mt-3">
          有任何問題或需求？歡迎透過以下方式與我們聯繫。
          我們也會在粉絲專頁發布最新活動與加持資訊。
        </p>
        <div class="mt-5">
          <div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:map-marker" />
            <span>高雄，台灣</span>
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:facebook" /><a
              href="https://facebook.com/441931809307993"
              target="_blank"
              rel="noopener">facebook.com/441931809307993</a
            >
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:clock" /><span>每週發文時間：週一至週日</span>
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
