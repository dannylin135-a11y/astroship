---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "線上光明燈",
    description:
      "線上點光明燈，法師每月初一十五頌經祈福，讓財神爺全年守護您的事業與財運。",
    icon: "bx:bxs-bulb",
  },
  {
    title: "包月加持",
    description:
      "包月服務讓您每月都能收到財神爺的加持，包含貴人金、化解小人符，好運不斷。",
    icon: "bx:bxs-calendar-heart",
  },
  {
    title: "聚寶盆",
    description:
      "財神爺欽點的聚寶盆，為您招財進寶，讓財富源源不斷流入。",
    icon: "bx:bxs-coin-stack",
  },
  {
    title: "化解小人",
    description:
      "小人擋道？財神爺親自為您化解，讓您做事順心、工作順利、貴人扶持。",
    icon: "bx:bxs-shield-plus",
  },
  {
    title: "貴人扶持",
    description:
      "財神爺為您牽引貴人，讓機會主動上門，事業運與財運雙雙提升。",
    icon: "bx:bxs-user-plus",
  },
  {
    title: "五行動態加持",
    description:
      "五行相生元寶，金木水火土循環不息，為您帶來生生不息的好運與財富。",
    icon: "bx:bxs-infinite",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    財神爺的祝福，隨時陪伴您
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    武德玄德宮提供多元線上服務，讓每一位信眾都能感受到財神爺的庇佑。
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
