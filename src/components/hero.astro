---
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="武德玄德宮 財神爺"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      武德玄德宮
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      供奉天官武財神，為信眾帶來財運與好運。
      線上光明燈、包月加持、聚寶盆，讓財神爺的祝福隨時陪伴您。
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="https://facebook.com/441931809307993"
        target="_blank"
        class="flex gap-1 items-center justify-center"
        rel="noopener">
        <Icon class="text-white w-5 h-5" name="bx:bxl-facebook" />
        追蹤粉絲專頁
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="/contact"
        class="flex gap-1 items-center justify-center"
        target="_self">
        <Icon class="text-black w-4 h-4" name="bx:bxs-phone-call" />
        聯絡我們
      </Link>
    </div>
  </div>
</main>
